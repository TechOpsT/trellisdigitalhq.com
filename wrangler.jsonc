{
  "name": "weathered-silence-1810",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "NOTION_DATABASE_ID": "b7fa2bb0-b8af-4a9f-8b6c-0033394de6e0"
  },
  "analytics_engine_datasets": [
    {
      "binding": "CONVERSION_ANALYTICS",
      "dataset": "trellis_conversion_events"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "previews": {
    "vars": {
      "PREVIEW_MODE": "true",
      "NOTION_DATABASE_ID": "preview-disabled"
    },
    "analytics_engine_datasets": [
      {
        "binding": "CONVERSION_ANALYTICS",
        "dataset": "trellis_conversion_events_preview"
      }
    ],
    "ratelimits": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "namespace_id": "1002",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
